{# Pending updates summary. Input: patch_summary (list of host reports). #}
<html>
<body style="font-family: Arial, sans-serif; color: #333;">
<h2 style="color: #2c3e50;">Pending updates report</h2>
<p>{{ now().strftime('%Y-%m-%d %H:%M %Z') }}</p>
<table style="border-collapse: collapse; width: 100%;">
  <tr style="background: #2c3e50; color: white;">
    <th style="padding: 8px; text-align: left;">Host</th>
    <th style="padding: 8px; text-align: left;">OS</th>
    <th style="padding: 8px; text-align: center;">Pending</th>
    <th style="padding: 8px; text-align: center;">Security</th>
    <th style="padding: 8px; text-align: center;">Reboot pending</th>
  </tr>
{% for r in patch_summary | sort(attribute='security_count', reverse=true) %}
  <tr style="background: {{ '#f8d7da' if (r.security_count | int) > 0 else ('#fff3cd' if (r.update_count | int) > 0 else '#d4edda') }};">
    <td style="padding: 6px; border: 1px solid #ddd;">{{ r.host | e }}</td>
    <td style="padding: 6px; border: 1px solid #ddd;">{{ r.os | e }}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">{{ r.update_count }}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center; font-weight: bold;">{{ r.security_count }}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">{{ 'yes' if r.reboot_required | bool else 'no' }}</td>
  </tr>
{% endfor %}
</table>
<p style="color: #666; font-size: 12px; margin-top: 20px;">Generated by Patch Manager</p>
</body>
</html>
