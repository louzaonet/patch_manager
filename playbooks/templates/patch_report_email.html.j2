{# Patch run summary. Input: all_results (list of patch_result dicts). #}
{% set total_updates = all_results | map(attribute='updates_count') | map('int') | sum %}
{% set reboots = all_results | selectattr('reboot_needed') | list | length %}
{% set failed = all_results | selectattr('status', 'equalto', 'FAILED') | list %}
<html>
<body style="font-family: 'Segoe UI', Arial, sans-serif; color: #333; max-width: 800px; margin: 0 auto;">
<div style="background: #2c3e50; color: white; padding: 16px; border-radius: 6px 6px 0 0;">
  <h2 style="margin: 0;">Patch Manager: patching report</h2>
  <p style="margin: 4px 0 0 0;">{{ now().strftime('%Y-%m-%d %H:%M %Z') }}</p>
</div>
<p><strong>{{ all_results | length }}</strong> hosts, <strong>{{ total_updates }}</strong> updates,
   <strong>{{ reboots }}</strong> still need a reboot{% if failed %},
   <strong style="color: #c0392b;">{{ failed | length }} failed</strong>{% endif %}.</p>
<table style="border-collapse: collapse; width: 100%;">
  <tr style="background: #2c3e50; color: white;">
    <th style="padding: 8px; text-align: left;">Host</th>
    <th style="padding: 8px; text-align: left;">OS</th>
    <th style="padding: 8px; text-align: center;">Updates</th>
    <th style="padding: 8px; text-align: center;">Mode</th>
    <th style="padding: 8px; text-align: center;">Status</th>
    <th style="padding: 8px; text-align: center;">Reboot pending</th>
  </tr>
{% for r in all_results %}
  <tr style="background: {{ '#fff' if loop.index is odd else '#f8f9fa' }};">
    <td style="padding: 6px; border: 1px solid #ddd;"><strong>{{ r.host | e }}</strong></td>
    <td style="padding: 6px; border: 1px solid #ddd;">{{ r.os | e }}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">{{ r.updates_count }}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">{{ r.mode }}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center;{{ ' color: #c0392b; font-weight: bold;' if r.status == 'FAILED' else '' }}">{{ r.status }}{% if r.error is defined %}<br><span style="font-weight: normal; font-size: 11px;">{{ r.error | e }}</span>{% endif %}</td>
    <td style="padding: 6px; border: 1px solid #ddd; text-align: center;">{{ 'yes' if r.reboot_needed | bool else 'no' }}</td>
  </tr>
{% endfor %}
</table>
{% for r in all_results if r.updates_before | length > 0 %}
<details style="margin-top: 8px;">
  <summary>{{ r.host | e }}: {{ r.updates_count }} updates</summary>
  <ul style="font-family: monospace; font-size: 12px;">
  {% for u in r.updates_before %}<li>{{ u | e }}</li>{% endfor %}
  </ul>
</details>
{% endfor %}
<p style="color: #999; font-size: 11px; margin-top: 24px; text-align: center;">Generated by Patch Manager (Ansible + Semaphore)</p>
</body>
</html>
