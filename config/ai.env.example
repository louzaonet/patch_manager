# =============================================================================
# Patch Manager AI: environment
# =============================================================================
#   cp config/ai.env.example config/ai.env && chmod 600 config/ai.env
# Docker reads it through env_file; the systemd unit through EnvironmentFile.
# Values are plain KEY=value (no quotes, no export).
# =============================================================================

# ─── LLM routing ────────────────────────────────────────────────────────────
# Format provider:model. Providers: openrouter, openai_compat (llama-swap,
# llama.cpp, vLLM), ollama, openai, anthropic.
#
# Option A (default): OpenRouter. Cheap and fast for this workload.
LLM_DEFAULT=openrouter:anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=
# Don't route to providers that store or train on prompts; keep reasoning short.
OPENROUTER_EXTRA_BODY={"provider": {"data_collection": "deny"}, "reasoning": {"effort": "low"}}
OPENROUTER_APP_TITLE=Patch Manager AI
# Alternatives: openrouter:google/gemini-2.5-flash-lite, openrouter:openai/gpt-oss-120b
#
# Option B: a local OpenAI-compatible server (llama-swap on another machine).
# Use ONE model for all nodes, or llama-swap unloads/loads models between
# nodes. The model name is the key in llama-swap's config.yaml
# (curl http://llm-host:8080/v1/models).
#   LLM_DEFAULT=openai_compat:gpt-oss-20b
#   OPENAI_COMPAT_BASE_URL=http://llm-host:8080/v1
#   OPENAI_COMPAT_API_KEY=not-needed
#   gpt-oss: keep reasoning short. For Qwen hybrid models use
#   {"chat_template_kwargs": {"enable_thinking": false}} instead.
#   OPENAI_COMPAT_EXTRA_BODY={"chat_template_kwargs": {"reasoning_effort": "low"}}
#
# Option C: hybrid. Intent + Q&A local, briefing in the cloud:
#   LLM_DEFAULT=openai_compat:gpt-oss-20b
#   LLM_NODE_GENERATE_BRIEFING=openrouter:anthropic/claude-haiku-5.5
#
# Per-node overrides (empty = use LLM_DEFAULT)
LLM_NODE_CLASSIFY_INTENT=
LLM_NODE_GENERATE_BRIEFING=
LLM_NODE_HANDLE_QUESTION=

# Empty = provider default (recommended; some reasoning models reject a custom value)
LLM_TEMPERATURE=
LLM_MAX_TOKENS=2048
# Seconds. Raise it for local servers that load the model on first use.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# Other providers (only if you use them)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://llm-host:11434
# OLLAMA_NUM_CTX=8192
# OLLAMA_REASONING=false

# ─── Dashboard / API authentication (required) ──────────────────────────────
APP_AUTH_USER=admin
APP_AUTH_PASSWORD=CHANGE_ME
# Optional bearer token for scripts: Authorization: Bearer <token>
APP_API_TOKEN=
# Swagger UI at /docs (authenticated). Off by default.
APP_ENABLE_DOCS=false
# Public URL of the dashboard, used in Slack/Teams links
PUBLIC_BASE_URL=https://patch-manager.example.com/ai/

# ─── Semaphore ──────────────────────────────────────────────────────────────
SEMAPHORE_URL=http://semaphore:3000
# Semaphore UI > user menu > API Tokens
SEMAPHORE_API_TOKEN=
# Set it if you have more than one project
SEMAPHORE_PROJECT_ID=
SEMAPHORE_TEMPLATE_APPLY=Apply Patches
SEMAPHORE_TEMPLATE_CHECK=Check Updates

# ─── Inventory and host reports ─────────────────────────────────────────────
INVENTORY_PATH=/opt/patch-manager/inventory/hosts.yml
REPORTS_PATH=/var/lib/patch-manager/reports
REPORT_MAX_AGE_HOURS=48

# ─── CVE enrichment ─────────────────────────────────────────────────────────
KEV_ENABLED=true
NVD_ENABLED=true
# Free key, raises the NVD limit from 5 to 50 requests per 30 s:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_LOOKUP_LIMIT=25
NVD_LOOKUP_BUDGET_SECONDS=45
NVD_CONTEXT_ENABLED=true
NVD_CONTEXT_DAYS=14

# ─── Patch plans ────────────────────────────────────────────────────────────
PLAN_TTL_MINUTES=30

# ─── Slack (optional) ───────────────────────────────────────────────────────
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=
# Only needed as a fallback when response_url can't be used
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#patch-management
# Slack user IDs allowed to /patch approve, comma-separated (U0123ABCD,...)
SLACK_APPROVER_IDS=

# ─── Microsoft Teams (optional) ─────────────────────────────────────────────
TEAMS_ENABLED=false
# Workflows webhook ("When a Teams webhook request is received")
TEAMS_WEBHOOK_URL=
# Outgoing Webhook security token (only for @mentions into the app)
TEAMS_OUTGOING_SECRET=

LOG_LEVEL=INFO
