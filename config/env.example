# =============================================================================
# Semaphore + PostgreSQL + email (Docker deployment)
# =============================================================================
#   cp config/env.example config/.env && chmod 600 config/.env
# Generate secrets with:  head -c32 /dev/urandom | base64
# =============================================================================

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=semaphore
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=semaphore

# Semaphore's view of the same database (keep in sync with the three above)
SEMAPHORE_DB_USER=semaphore
SEMAPHORE_DB_PASS=CHANGE_ME_db_password
SEMAPHORE_DB=semaphore

# ─── Semaphore admin and keys ───────────────────────────────────────────────
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Administrator
SEMAPHORE_ADMIN_EMAIL=admin@example.com
SEMAPHORE_ADMIN_PASSWORD=CHANGE_ME_admin_password
# Encrypts the key store (SSH keys, passwords). Losing it = re-entering secrets.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=CHANGE_ME_base64_32_bytes
# Session cookies; without these, every restart logs everybody out.
SEMAPHORE_COOKIE_HASH=CHANGE_ME_base64_32_bytes
SEMAPHORE_COOKIE_ENCRYPTION=CHANGE_ME_base64_32_bytes
# Public URL (enables secure cookies behind the proxy)
SEMAPHORE_WEB_ROOT=https://patch-manager.example.com

# ─── Email reports sent by the playbooks ────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=patches@example.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
